{
  "description": "Test fixture manifest documenting expected properties for each PDF file. Used by unit and property-based tests to verify correct behavior.",
  "fixtures": {
    "simple-one-image.pdf": {
      "description": "Single uncompressed 2x2 RGB image on one page",
      "pageCount": 1,
      "expectedImages": [
        {
          "width": 2,
          "height": 2,
          "bitsPerComponent": 8,
          "colorSpace": "/DeviceRGB",
          "filter": null,
          "decodedStreamLength": 12,
          "rawStreamLength": 12
        }
      ],
      "totalImageCount": 1,
      "requirements": ["2.1", "3.1", "4.1"]
    },
    "multi-image.pdf": {
      "description": "3 images across 2 pages. Page 1: 4x4 RGB + 2x2 Gray. Page 2: 3x3 RGB.",
      "pageCount": 2,
      "expectedImages": [
        {
          "width": 4,
          "height": 4,
          "bitsPerComponent": 8,
          "colorSpace": "/DeviceRGB",
          "filter": null,
          "decodedStreamLength": 48,
          "rawStreamLength": 48
        },
        {
          "width": 2,
          "height": 2,
          "bitsPerComponent": 8,
          "colorSpace": "/DeviceGray",
          "filter": null,
          "decodedStreamLength": 4,
          "rawStreamLength": 4
        },
        {
          "width": 3,
          "height": 3,
          "bitsPerComponent": 8,
          "colorSpace": "/DeviceRGB",
          "filter": null,
          "decodedStreamLength": 27,
          "rawStreamLength": 27
        }
      ],
      "totalImageCount": 3,
      "requirements": ["3.1", "3.2"]
    },
    "no-images.pdf": {
      "description": "Valid PDF with text content only, no image XObjects",
      "pageCount": 1,
      "expectedImages": [],
      "totalImageCount": 0,
      "requirements": ["3.7"]
    },
    "jpeg-compressed.pdf": {
      "description": "Single 2x2 grayscale image with DCTDecode (JPEG) compression",
      "pageCount": 1,
      "expectedImages": [
        {
          "width": 2,
          "height": 2,
          "bitsPerComponent": 8,
          "colorSpace": "/DeviceGray",
          "filter": "/DCTDecode",
          "decodedStreamLength": 4,
          "rawStreamLength": null
        }
      ],
      "totalImageCount": 1,
      "notes": "rawStreamLength is the byte length of the embedded JPEG data (variable depending on JPEG encoding). decodedStreamLength is 2*2*1 = 4 bytes of uncompressed grayscale pixels.",
      "requirements": ["4.1", "4.2"]
    },
    "nested-forms.pdf": {
      "description": "One image directly on the page (2x2 RGB), one image inside a Form XObject (3x3 RGB). Tests recursive enumeration.",
      "pageCount": 1,
      "expectedImages": {
        "recursive_false": [
          {
            "width": 2,
            "height": 2,
            "bitsPerComponent": 8,
            "colorSpace": "/DeviceRGB",
            "filter": null,
            "decodedStreamLength": 12,
            "rawStreamLength": 12
          }
        ],
        "recursive_true": [
          {
            "width": 2,
            "height": 2,
            "bitsPerComponent": 8,
            "colorSpace": "/DeviceRGB",
            "filter": null,
            "decodedStreamLength": 12,
            "rawStreamLength": 12
          },
          {
            "width": 3,
            "height": 3,
            "bitsPerComponent": 8,
            "colorSpace": "/DeviceRGB",
            "filter": null,
            "decodedStreamLength": 27,
            "rawStreamLength": 27
          }
        ]
      },
      "totalImageCount": {
        "recursive_false": 1,
        "recursive_true": 2
      },
      "requirements": ["3.4", "3.5"]
    }
  }
}
