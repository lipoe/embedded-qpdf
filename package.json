{
  "name": "@emborado/qpdf-image-streams",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-compatible WASM module exposing qpdf's library API for reading and replacing PDF image streams",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/qpdf-image-stream.js",
    "dist/qpdf-image-stream.wasm"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:pbt": "vitest run test/pbt",
    "test:watch": "vitest",
    "playground": "npx --yes serve ."
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "fast-check": "^3.19.0",
    "playwright": "^1.44.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
